# Supabase Postgres — pooler (transaction mode, usado pela aplicação)
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Supabase Postgres — sessão direta (usado pelas migrations Prisma)
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo usado para assinar os JWTs (access/refresh)
JWT_SECRET="<gere-um-segredo-forte>"

# Seed inicial do ADMIN (apenas no primeiro provisionamento)
ADMIN_EMAIL="admin@fabrica.local"
ADMIN_NOME="Administrador"
ADMIN_SENHA="<defina-uma-senha-forte>"
